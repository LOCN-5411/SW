# Python
__pycache__/
*.py[cod]

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# SolidWorks 临时与锁定文件（等你开始建模后会用到）
*.sldprt~
*.sldasm~
*.slddrw~
~$*.SLDPRT
~$*.SLDASM
~$*.SLDDRW
*.tmp

# 导出中间文件
*.log

# ── SolidWorks 安装目录（重要）────────────────────────────────────
# SolidWorks 被装在了本工作区根目录 E:\SW\ 下：7.58 GB、19,927 个文件。
# 这是程序安装文件，不是学习资料，绝不能进 git 仓库。
/SOLIDWORKS/
/eDrawings/

# 你的练习模型默认不忽略 —— 想备份就正常 git add；
# 如果不想让它们进仓库，取消下面几行注释即可。
# *.SLDPRT
# *.SLDASM
# *.SLDDRW
